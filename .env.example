# Copie para .env e troque os valores. Nunca commite o .env.
# Senhas: use letras, números e hífens (sem @ & $ que quebram URLs).

# ---------------------------------------------------------------------------
# Banco de dados do Keycloak
# ---------------------------------------------------------------------------
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=troque-esta-senha-banco

# ---------------------------------------------------------------------------
# Conta de administrador do Keycloak
# Usada apenas no primeiro boot para criar o usuário admin.
# Após isso, gerencie via Admin Console.
# ---------------------------------------------------------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=troque-esta-senha-admin

# ---------------------------------------------------------------------------
# Porta exposta no host
# ---------------------------------------------------------------------------
KC_PORT=8080

# ---------------------------------------------------------------------------
# Configuração de hostname
#
# Desenvolvimento local (padrão):
#   KC_HOSTNAME_STRICT=false
#   KC_HTTP_ENABLED=true
#   KC_HOSTNAME=http://localhost:8080 (URL pública fixa, igual ao issuer do app)
#
# Produção (com domínio + reverse proxy com TLS):
#   KC_HOSTNAME=auth.seu-dominio.com
#   KC_HOSTNAME_STRICT=true
#   KC_HTTP_ENABLED=true (TLS termina no proxy)
#   KC_PROXY_HEADERS=xforwarded
# ---------------------------------------------------------------------------
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_HOSTNAME=http://localhost:8080
KC_PROXY_HEADERS=xforwarded
KC_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Google OAuth (opcional)
# Como obter: https://console.cloud.google.com → Credenciais → ID do cliente OAuth
#
# URI de redirecionamento autorizado no Google Cloud Console:
#   http://localhost:8080/realms/enxoval/broker/google/endpoint      (dev)
#   https://auth.seu-dominio.com/realms/enxoval/broker/google/endpoint  (produção)
#
# Deixe vazios para desabilitar o login com Google.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IDP_HABILITADO=false

# ---------------------------------------------------------------------------
# Domínio de produção — usado nos redirect URIs dos realms
# ---------------------------------------------------------------------------
APP_ENXOVAL_URL=http://localhost:5180
